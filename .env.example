# Copy this file to .env and fill in what you need.
# Everything has a free/local default — you can run the whole MVP with
# an empty .env except LLM keys if you want the LLM fallback active.

# --- Database ---
# Leave blank to use local SQLite (zero setup). For Supabase Postgres:
# DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres
DATABASE_URL=

# --- Classification ---
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.55

# --- LLM fallback for ambiguous transactions ---
# "groq" (free tier, recommended to start), "openai", or "none" to disable fallback entirely
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- OCR ---
# "tesseract" (free, local) or "google_vision" (paid, not wired up yet — see services/ocr.py)
OCR_ENGINE=tesseract
GOOGLE_VISION_API_KEY=

# --- Anomaly detection ---
# Z-score outlier check: how many standard deviations from the mean (within
# its own ledger head group) counts as unusual. Lower = more sensitive.
ANOMALY_ZSCORE_THRESHOLD=2.0
# Minimum transactions in a ledger head group before z-score is computed at all
# (groups smaller than this are too noisy for a meaningful z-score).
ANOMALY_MIN_GROUP_SIZE=3
# Absolute rupee amount above which a transaction is flagged for review
# regardless of its ledger head group or z-score — catches large one-off
# transactions that a small/misclassified group would otherwise hide.
ANOMALY_HIGH_VALUE_THRESHOLD=100000

# --- Auth (Section 20) ---
# CRITICAL: generate a real random secret before any real deployment, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# The app logs a loud warning on startup if this is left at its insecure default.
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Security (Section 22) ---
# Comma-separated list of allowed frontend origins for CORS. Defaults to
# localhost only (see config.py) -- override for a real deployment.
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
# Max upload size in megabytes.
MAX_UPLOAD_SIZE_MB=25

# --- PostgreSQL (docker-compose.yml) ---
# Only used by docker-compose.yml's Postgres service -- irrelevant if
# you're running locally with SQLite (the DATABASE_URL default above).
POSTGRES_USER=ledgerlens_user
POSTGRES_PASSWORD=changeme-in-production
POSTGRES_DB=ledgerlens

# --- Rate limiting (Section 22) ---
# Applied to /auth/login and /auth/register to slow brute-force /
# credential-stuffing attempts. Format: "<count>/<period>", e.g. "5/minute".
LOGIN_RATE_LIMIT=5/minute
REGISTER_RATE_LIMIT=10/hour

# --- Password reset ---
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
# "console" (default, free): logs the reset link instead of sending a real
# email -- fine for local dev. "smtp": sends a real email via the settings
# below. See app/services/email_sender.py.
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@ledgerlens.local
# Base URL of your frontend, used to build the reset link sent by email.
FRONTEND_BASE_URL=http://localhost:8501
